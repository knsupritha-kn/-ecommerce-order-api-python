MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# AI provider: "ollama" (default, local) or "gemini" (use on Render, where there is no Ollama).
# Embeddings are NOT compatible across providers: they are stored in separate fields
# (embedding_ollama / embedding_gemini) and search only uses the active provider's field.
# After switching provider, run POST /ai/products/reindex (admin) to fill that provider's field.
LLM_PROVIDER=ollama

# Gemini (only used when LLM_PROVIDER=gemini). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_CHAT_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIMENSIONS=768

# Optional: local Ollama AI layer. If Ollama is unreachable, /ai/* returns 503
# and the rest of the app works normally. (In Docker use http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text

# Use Atlas $vectorSearch (needs the "product_vector_index" Atlas index). When false,
# search uses an in-Python cosine similarity. Cosine is also the fallback if Atlas returns nothing.
USE_ATLAS_VECTOR_SEARCH=false

# Minimum cosine similarity (0-1) for a semantic search hit to be returned. Raise to be stricter.
# Scores are logged at DEBUG level (logger "app.routes.products") to help tune this.
SEARCH_MIN_SCORE=0.5

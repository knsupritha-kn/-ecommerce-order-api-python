MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# Optional: local Ollama AI layer. If Ollama is unreachable, /ai/* returns 503
# and the rest of the app works normally. (In Docker use http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text

# Use Atlas $vectorSearch (needs the "product_vector_index" Atlas index). When false,
# search uses an in-Python cosine similarity. Cosine is also the fallback if Atlas returns nothing.
USE_ATLAS_VECTOR_SEARCH=false

# Minimum cosine similarity (0-1) for a semantic search hit to be returned. Raise to be stricter.
# Scores are logged at DEBUG level (logger "app.routes.products") to help tune this.
SEARCH_MIN_SCORE=0.5
